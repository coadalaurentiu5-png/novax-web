# Copiază acest fișier ca .env (local) sau setează valorile în Render → Environment

# MongoDB (găsești pe MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/novax

# Domeniul live
BASE_URL=https://novax-web.onrender.com

# Parola pentru dashboard-ul de admin (lasă gol DOAR în dezvoltare)
ADMIN_KEY=

# ---------- Paysafecard + Discord ----------
# Link-ul permanent al serverului tău de Discord
DISCORD_INVITE_URL=https://discord.gg/TAIA_SA_TA

# Webhook către canalul SECRET de staff (primește notificări pentru fiecare comandă Paysafe)
# Cum creezi: Server Settings → Integrations → Webhooks → New Webhook → selectezi canalul secret
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Durata (în minute) până expiră o comandă Paysafecard (cronometru)
PAYSAFE_ORDER_TTL_MINUTES=10
